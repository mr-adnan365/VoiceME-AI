# Copy this file to .env and uncomment what you want to change.
# Every setting is optional; the defaults work out of the box.

# --- Web server ---------------------------------------------------------------
# VOICEME_HOST=127.0.0.1
# VOICEME_PORT=8000

# --- Language model (Ollama) --------------------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi4-mini
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=200
# VOICEME_SYSTEM_PROMPT=You are VoiceMe, a friendly voice assistant. Answer in one to three short spoken sentences.

# --- Speech to text (faster-whisper) ------------------------------------------
# tiny.en (fastest) | base.en (default) | small.en (more accurate) | small, medium (multilingual)
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=auto          # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=int8    # int8 | float16 (GPU) | float32
# WHISPER_LANGUAGE=en          # a language code such as fr, or "auto" to detect it

# --- Text to speech (Piper) ---------------------------------------------------
# Browse voices: https://huggingface.co/rhasspy/piper-voices/tree/main
# PIPER_VOICE=en_US-lessac-medium

# --- Limits -------------------------------------------------------------------
# MAX_HISTORY_TURNS=8
# MAX_AUDIO_MB=15
# VOICEME_MODELS_DIR=./models
